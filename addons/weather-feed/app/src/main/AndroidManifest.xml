<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only permission: Open-Meteo, for the temperature at the place in options.xml. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <!-- Read-only: the launcher (weather_temp) asks for the last reading. Nothing to protect, a temperature. -->
        <provider
            android:name=".WeatherProvider"
            android:authorities="com.gathin.weatherfeed"
            android:exported="true" />
    </application>
</manifest>
